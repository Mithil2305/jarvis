# ---------------------------------------------------------------------------
# Jarvis Telegram Remote Access Configuration
# ---------------------------------------------------------------------------

# 1. Telegram Bot Token:
# Get this by talking to @BotFather on Telegram (send /newbot and follow instructions)
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# 2. Security Whitelist:
# Comma-separated list of Telegram User IDs allowed to control Jarvis.
# If you don't know your ID, start the bot, send a message, and the bot will reply with your ID!
# Or get it instantly by chatting with @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS="123456789"

# 3. Voice Reply Mode:
# - adaptive: Reply with voice notes to voice notes, and text to text (Recommended)
# - always:   Always synthesize and reply with Kokoro voice notes
# - never:    Reply with text only
TELEGRAM_VOICE_MODE="adaptive"

# 4. Optional LLM & TTS Overrides:
# JARVIS_LLM_URL="http://127.0.0.1:8080/v1/chat/completions"
# JARVIS_TTS_VOICE="af_heart"
# JARVIS_STT_MODEL="large-v3"
